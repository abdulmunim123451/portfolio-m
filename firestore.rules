rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // ADMIN AUTHORIZATION HELPER
    // Restricts ALL write, create, update, and delete actions strictly
    // to your specific Google Firebase Auth UID.
    // Replace 'YOUR_ADMIN_UID_HERE' with your real Firebase Auth UID.
    // Visitors only have read access.
    // ===============================================================
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'YOUR_ADMIN_UID_HERE'
      );
    }

    // Projects collection
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Skills collection
    match /skills/{skillId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Profile document (e.g. profile/main)
    match /profile/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Experience / Internships collection
    match /experience/{expId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Certificates collection
    match /certificates/{certId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Resume document (e.g. resume/main)
    match /resume/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
