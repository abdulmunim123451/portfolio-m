# Firebase Configuration (Vite)
# Replace these values with your actual Firebase Project credentials
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# Restrict admin portal strictly to this specific Firebase Auth Google UID
# You can copy your UID with 1 click from /admin/settings or from the login error message
VITE_ADMIN_UID=YOUR_ADMIN_UID_HERE

# Fallback authorized admin email (used if VITE_ADMIN_UID is not yet set)
VITE_ADMIN_EMAIL=abdulmunim1234512345@gmail.com
